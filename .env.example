# ---------------------------------------------------------------------------
# GGMCA website - environment template
#
#   cp .env.example .env
#
# Anything prefixed with VITE_ is inlined into the static build at build time,
# so changing one requires a rebuild (`docker compose up --build -d`). The
# non-prefixed values are read by Docker Compose at runtime.
# ---------------------------------------------------------------------------

# --- Container ports -------------------------------------------------------
# Host port the production nginx container is published on.
APP_PORT=8080
# Host port for the optional Vite dev server (`--profile dev`).
DEV_PORT=5173
# development for local work, production for built images.
NODE_ENV=development

# --- Site identity ---------------------------------------------------------
# Canonical origin, used for <link rel="canonical"> and social sharing tags.
# No trailing slash. Use the real public origin for production builds.
VITE_SITE_URL=https://myglendale.ca
VITE_SITE_NAME=Glendale / Glendale Meadows Community Association

# --- Contact details -------------------------------------------------------
VITE_CONTACT_EMAIL=info@myglendale.ca
VITE_CONTACT_PHONE=403-242-2110
VITE_ADDRESS=4500 25 Avenue SW, Calgary, AB T3E 0M1

# --- Social profiles -------------------------------------------------------
# Confirm these handles with the office before launch. A value is inlined into
# the build; leaving one blank falls back to the default in src/config.ts rather
# than hiding the link, so every build path renders the same footer.
VITE_SOCIAL_FACEBOOK=https://www.facebook.com/myglendale
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/myglendale
VITE_SOCIAL_X=https://x.com/myglendale
